rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'quizCount', 'pollCount', 'followersCount', 'followingCount', 'referralCount', 'referralPointsEarned'])
      );
      allow delete: if isOwner(userId);

      // Subcollection: Personal Bookmarks
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: User Voted Polls
      match /votedPolls/{pollId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: User Notifications
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated();
      }
    }

    // Comments collection with sub-collections for quizzes and polls
    match /comments/{category}/{targetId}/items/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Referral records
    match /referrals/{referralId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.refereeUserId == request.auth.uid;
    }

    // Username reservation
    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Posts (quiz, poll, discussion)
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Subcollection: Likes
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Subcollection: Comments
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'replyCount'])
        );
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

        // Subcollection: Replies
        match /replies/{replyId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
          allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
        }
      }

      // Subcollection: Bookmarks
      match /bookmarks/{userId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Quizzes
    match /quizzes/{quizId} {
      allow read: if isAuthenticated() && (resource.data.isPublic == true || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attemptCount', 'averageScore', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Questions
      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Individual Quiz Leaderboard (ranked scores, accuracy, and times per user)
      match /leaderboard/{userId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Quiz attempts
    match /quizAttempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource == null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // General Quiz Performance Competition Leaderboards (Weekly and All-Time)
    match /competitionLeaderboards/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Polls
    match /polls/{pollId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['optionVotes', 'totalVotes'])
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Votes
      match /votes/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // Follows
    match /follows/{userId}/following/{targetUid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    match /follows/{userId}/followers/{followerUid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(followerUid);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.recipientUserId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.senderUserId == request.auth.uid;
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterUserId == request.auth.uid;
      allow read, update, delete: if false; // reporter and details strictly protected from public
    }

    // Blocks
    match /blocks/{userId}/users/{blockedUid} {
      allow read, write: if isOwner(userId);
    }
  }
}
