rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email_verified == true &&
          request.auth.token.email in ['rohitpandit55970@gmail.com']) ||
        request.auth.token.admin == true
      );
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || (
        isAuthenticated() && resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'quizCount', 'pollCount', 'followersCount', 'followingCount', 'referralCount', 'referralPointsEarned'])
      );
      allow delete: if isOwner(userId);

      // Subcollection: Personal Bookmarks
      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: User Voted Polls
      match /votedPolls/{pollId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: User Notifications
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated();
      }
    }

    // Comments collection with sub-collections for quizzes and polls
    match /comments/{category}/{targetId}/items/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Referral records
    match /referrals/{referralId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.refereeUserId == request.auth.uid;
    }

    // Username reservation
    match /usernames/{username} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Posts (quiz, poll, discussion)
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount', 'updatedAt']))
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Subcollection: Likes
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // Subcollection: Comments
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          (resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'replyCount']))
        );
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

        // Subcollection: Replies
        match /replies/{replyId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
          allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
        }
      }

      // Subcollection: Bookmarks
      match /bookmarks/{userId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Quizzes
    match /quizzes/{quizId} {
      allow read: if isAuthenticated() && (resource.data.isPublic == true || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attemptCount', 'averageScore', 'updatedAt']))
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Questions
      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }

      // Individual Quiz Leaderboard (ranked scores, accuracy, and times per user)
      match /leaderboard/{userId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Quiz attempts
    match /quizAttempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource == null);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // General Quiz Performance Competition Leaderboards (Weekly and All-Time)
    match /competitionLeaderboards/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Polls
    match /polls/{pollId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (resource != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['optionVotes', 'totalVotes']))
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Votes
      match /votes/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // Follows
    match /follows/{userId}/following/{targetUid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    match /follows/{userId}/followers/{followerUid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(followerUid);
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.recipientUserId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.senderUserId == request.auth.uid;
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterUserId == request.auth.uid;
      allow read, update, delete: if false; // reporter and details strictly protected from public
    }

    // Blocks
    match /blocks/{userId}/users/{blockedUid} {
      allow read, write: if isOwner(userId);
    }

    // Wallets (Coin & Cash conversion ledger)
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Users cannot forge payout status fields (only an admin can change them).
      allow create: if isAdmin() || (isOwner(userId)
        && request.resource.data.get('paidWithdrawalPaisa', 0) == 0
        && request.resource.data.get('approvedWithdrawalPaisa', 0) == 0
        && request.resource.data.get('rejectedWithdrawalPaisa', 0) == 0);
      allow update: if isAdmin() || (isOwner(userId)
        && request.resource.data.get('paidWithdrawalPaisa', 0) == resource.data.get('paidWithdrawalPaisa', 0)
        && request.resource.data.get('approvedWithdrawalPaisa', 0) == resource.data.get('approvedWithdrawalPaisa', 0)
        && request.resource.data.get('rejectedWithdrawalPaisa', 0) == resource.data.get('rejectedWithdrawalPaisa', 0));
      allow delete: if isAdmin();
    }

    // Coin Transactions (Immutable ledger records)
    match /coinTransactions/{transactionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Withdrawal Requests (UPI payout requests)
    match /withdrawalRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'PENDING';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Earning & Monetization Global Configuration
    match /earningConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // App Configuration
    match /appConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Rewarded Ad Claims
    match /rewardedAdClaims/{claimId} {
      allow read, create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Daily Check-in records
    match /dailyCheckins/{checkinId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (checkinId.matches('^' + request.auth.uid + '_.*') || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Daily Challenge records
    match /dailyChallenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (challengeId.matches('^' + request.auth.uid + '_.*') || request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Question Answer Rewards
    match /answerRewards/{rewardId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (rewardId.matches('^' + request.auth.uid + '_.*') || request.resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Post Rewards
    match /postRewards/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Admin Audit Logs
    match /adminAuditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
